{
  "name": "import-erp-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node test/authorization.test.mjs && node test/data-issues.test.mjs",
    "start": "node dist/server.js",
    "migrate:status": "node --env-file-if-exists=.env dist/migrate.js status",
    "migrate:up": "node --env-file-if-exists=.env dist/migrate.js up",
    "bootstrap:admin": "node --env-file-if-exists=.env dist/bootstrap-admin.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.6.2",
    "openid-client": "^6.8.4",
    "pg": "^8.23.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  }
}
