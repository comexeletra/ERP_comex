# Production values belong in /etc/import-erp/api.env on the VPS.
# Any local development must use a disposable database, never production data.
# Keep PostgreSQL on loopback and use a least-privilege application role.
DATABASE_URL=postgresql://import_erp_app:REPLACE_ME@127.0.0.1:5432/import_erp
DATABASE_POOL_MAX=5

# Release migration job only; use a separate least-privilege migration role.
# Migration commands require MIGRATION_ENV=isolated or MIGRATION_ENV=production.
# Keep unset for local development unless applying migrations to a disposable DB.
# MIGRATION_ENV=isolated
# MIGRATION_DATABASE_URL=postgresql://import_erp_migrator:REPLACE_ME@127.0.0.1:5432/import_erp
# For an isolated remote test database, also set ALLOW_REMOTE_MIGRATIONS=true.
# ALLOW_REMOTE_MIGRATIONS=true

# Must match Vercel VPS_API_TOKEN for the same environment.
GATEWAY_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET

# OIDC credentials stay on the API host. Production origin is the Vercel app URL;
# register its /auth/callback path in the identity provider.
OIDC_ISSUER=https://identity.example.com
OIDC_CLIENT_ID=REPLACE_ME
OIDC_CLIENT_SECRET=REPLACE_ME
# Set to client_secret_post only if required by the selected provider.
OIDC_CLIENT_AUTH_METHOD=client_secret_basic
AUTH_SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
APP_PUBLIC_ORIGIN=https://your-app.vercel.app

# One-time first administrator bootstrap only; never enable in the API service.
# Requires a separate local PostgreSQL credential and migrations M003+ applied.
# ALLOW_ADMIN_BOOTSTRAP=true
# ADMIN_BOOTSTRAP_DATABASE_URL=postgresql://bootstrap_admin:REPLACE_ME@127.0.0.1:5432/import_erp
# ADMIN_BOOTSTRAP_SUBJECT=OIDC_SUBJECT_FROM_IDP
# ADMIN_BOOTSTRAP_DISPLAY_NAME=Administrator Name
# ADMIN_BOOTSTRAP_IMPORTERS=ELETRA MATRIZ,ELETRA FOR

# Restrict listener to local reverse proxy or Cloudflare Tunnel.
HOST=127.0.0.1
PORT=4000
