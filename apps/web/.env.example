# Optional local development only. Production never depends on this machine.
API_DEV_ORIGIN=http://localhost:4000

# Vercel Production only. Add as server-side variables; never use NEXT_PUBLIC_.
# VPS_API_URL must be the exact HTTPS origin, without path or credentials.
# VPS_API_TOKEN must equal GATEWAY_TOKEN from the matching VPS API environment.
# The PostgreSQL URI and OIDC credentials belong only on the Hostinger VPS.
VPS_API_URL=
VPS_API_TOKEN=

# Vercel Preview only. Point to an isolated staging API and test database.
# Preview does not fall back to VPS_API_URL/VPS_API_TOKEN when these are empty.
PREVIEW_API_URL=
PREVIEW_API_TOKEN=
